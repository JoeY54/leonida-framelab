if(@FRAMELAB_BUILD_VULKAN_SR@)
  include(CMakeFindDependencyMacro)
  find_dependency(Vulkan 1.2)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/FrameLabTargets.cmake")
