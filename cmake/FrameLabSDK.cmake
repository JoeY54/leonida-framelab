include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

add_library(FrameLab src/core/fg_stream.cpp)
add_library(FrameLab::FrameLab ALIAS FrameLab)
target_compile_features(FrameLab PRIVATE cxx_std_20)
target_include_directories(FrameLab
  PUBLIC
    "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>"
    "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
  PRIVATE "${PROJECT_SOURCE_DIR}/fg"
)
set_target_properties(FrameLab PROPERTIES CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
get_target_property(framelab_type FrameLab TYPE)
if(framelab_type STREQUAL "SHARED_LIBRARY")
  target_compile_definitions(FrameLab PUBLIC FRAMELAB_SHARED PRIVATE FRAMELAB_BUILDING)
  set_target_properties(FrameLab PROPERTIES VERSION "${PROJECT_VERSION}" SOVERSION 1)
endif()

option(FRAMELAB_BUILD_D3D12_FG "Build the Windows Direct NGX FG module (external SDK)" OFF)
option(FRAMELAB_BUILD_D3D12_SR "Build the Windows Direct NGX DLSS Super Resolution module (external SDK)" OFF)
if(FRAMELAB_BUILD_D3D12_FG OR FRAMELAB_BUILD_D3D12_SR)
  if(NOT WIN32 OR NOT BUILD_SHARED_LIBS OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "FRAMELAB_BUILD_D3D12_FG and FRAMELAB_BUILD_D3D12_SR require a 64-bit Windows shared build.")
  endif()
  set(DLSS_NGX_SDK_ROOT "" CACHE PATH "DLSS SDK root with D3D12 NGX headers")
  set(framelab_ngx_d3d12_library "${DLSS_NGX_SDK_ROOT}/lib/Windows_x86_64/x64/nvsdk_ngx_d.lib")
  if(NOT EXISTS "${framelab_ngx_d3d12_library}" OR NOT EXISTS "${DLSS_NGX_SDK_ROOT}/include/nvsdk_ngx.h")
    message(FATAL_ERROR "Set DLSS_NGX_SDK_ROOT to the external DLSS SDK with D3D12 NGX headers and x64 library.")
  endif()
  # One process-wide NGX D3D12 session owner shared by the D3D12 components.
  target_sources(FrameLab PRIVATE src/backends/d3d12/ngx_session.cpp)
  target_include_directories(FrameLab PRIVATE "${DLSS_NGX_SDK_ROOT}/include")
  target_link_libraries(FrameLab PRIVATE "${framelab_ngx_d3d12_library}" d3d12 dxgi shlwapi advapi32 psapi user32)
endif()
if(FRAMELAB_BUILD_D3D12_FG)
  if(NOT EXISTS "${DLSS_NGX_SDK_ROOT}/include/nvsdk_ngx_helpers_dlssg_d3d.h")
    message(FATAL_ERROR "Set DLSS_NGX_SDK_ROOT to the external DLSS SDK with D3D12 NGX FG headers.")
  endif()
  target_sources(FrameLab PRIVATE src/backends/d3d12/ngx_fg.cpp)
  install(FILES include/framelab/d3d12_fg.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/framelab")
endif()
if(FRAMELAB_BUILD_D3D12_SR)
  if(NOT EXISTS "${DLSS_NGX_SDK_ROOT}/include/nvsdk_ngx_helpers.h")
    message(FATAL_ERROR "Set DLSS_NGX_SDK_ROOT to the external DLSS SDK with the DLSS SR helper headers.")
  endif()
  target_sources(FrameLab PRIVATE src/backends/d3d12/ngx_sr.cpp)
  install(FILES include/framelab/d3d12_sr.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/framelab")
endif()

option(FRAMELAB_BUILD_VULKAN_SR "Build the Windows Vulkan Streamline SR component (external SDK)" OFF)
if(FRAMELAB_BUILD_VULKAN_SR)
  if(NOT WIN32 OR NOT BUILD_SHARED_LIBS OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "FRAMELAB_BUILD_VULKAN_SR requires a 64-bit Windows shared build.")
  endif()
  find_package(Vulkan 1.2 REQUIRED)
  set(FRAMELAB_STREAMLINE_SDK_ROOT "" CACHE PATH "External NVIDIA Streamline SDK root")
  if(NOT EXISTS "${FRAMELAB_STREAMLINE_SDK_ROOT}/include/sl_dlss.h")
    message(FATAL_ERROR "Set FRAMELAB_STREAMLINE_SDK_ROOT to the external Streamline SDK.")
  endif()
  target_sources(FrameLab PRIVATE src/backends/vulkan/streamline_sr.cpp)
  target_include_directories(FrameLab PRIVATE "${FRAMELAB_STREAMLINE_SDK_ROOT}/include")
  target_link_libraries(FrameLab PUBLIC Vulkan::Vulkan)
  install(FILES include/framelab/vulkan_sr.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/framelab")
endif()

set(framelab_package_dir "${CMAKE_INSTALL_LIBDIR}/cmake/FrameLab")
configure_package_config_file(cmake/FrameLabConfig.cmake.in
  "${PROJECT_BINARY_DIR}/FrameLabConfig.cmake" INSTALL_DESTINATION "${framelab_package_dir}")
write_basic_package_version_file("${PROJECT_BINARY_DIR}/FrameLabConfigVersion.cmake"
  VERSION "${PROJECT_VERSION}" COMPATIBILITY ExactVersion)

install(TARGETS FrameLab EXPORT FrameLabTargets)
install(FILES include/framelab/framelab.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/framelab")
install(EXPORT FrameLabTargets NAMESPACE FrameLab:: DESTINATION "${framelab_package_dir}")
install(FILES "${PROJECT_BINARY_DIR}/FrameLabConfig.cmake" "${PROJECT_BINARY_DIR}/FrameLabConfigVersion.cmake"
  DESTINATION "${framelab_package_dir}")
install(FILES LICENSE DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/licenses/FrameLab")
